DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,.ngrok-free.app,.ngrok.io,.trycloudflare.com
# Use "sqlite" for local file DB, or postgres://user:pass@host:5432/db for Docker
DATABASE_URL=sqlite
REDIS_URL=redis://127.0.0.1:6379/0
# Set USE_REDIS=1 when Redis is available (Docker). Local sqlite auto-uses LocMem cache.
USE_REDIS=0
CORS_ORIGINS=http://localhost:3000
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=telemed_webhook_verify_token_123
META_WA_APP_SECRET=
# Clinic WhatsApp E.164 digits only (no +) for patient app wa.me deep links
CLINIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Expo customer app: EXPO_PUBLIC_API_URL=http://localhost:8000 (or your LAN IP)
